# Configuracao da carga dos paineis InvestSUS. Copie para .env (na raiz do projeto) e preencha.
# O codigo le SOMENTE o .env da raiz do projeto.
FNS_DB_HOST=localhost
FNS_DB_PORT=5433
FNS_DB_NOME=transferepro
FNS_DB_USUARIO=postgres
FNS_DB_SENHA=m@ria3105
# Tablespace para tabelas, indices e temporarios. Obrigatorio ter a linha; deixe VAZIO para usar o padrao do servidor.
# Nesta maquina Windows: ts_faf (D:\pgdata_faf). No Linux, normalmente vazio.
FNS_DB_TABLESPACE=ts_faf
